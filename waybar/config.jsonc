
{
 
    "height": 28, 
    "spacing": 2, 
    "modules-left": [
        "wlr/taskbar",
        "custom/divider",
        "mpris"
      
    ],
    "modules-center": [
],
    "modules-right": [
        "memory",
        "custom/divider",
        "pulseaudio",
        "custom/divider",
        "network",
        "custom/divider",
        "battery",
        "custom/divider",
        "clock",

    ],


    "wlr/taskbar": {
        "format": " {title:.17}",
        "separator": " | ",
        "spacing": 4,
        "on-click-middle": "close",
        "tooltip-format": "{title}",
        "ignore-list": [],
        "on-click": "activate"
    },
 

   "mpris": {
	"format": "{player_icon} {dynamic}",
"dynamic-len": 30,
	"format-paused": "{status_icon} <i>{dynamic}</i>",
	"player-icons": {
		"default": "▶",
		"mpv": "󰎇"
	},
	"status-icons": {
		"paused": "⏸"
	},
	// "ignored-players": ["firefox"]
},

    "clock": {
        "tooltip-format": "<big>{:%A, %B %d}</big>\n<tt><small>{calendar}</small></tt>",
        "format": "{:%d/%m/%y - %H:%M}"
    },
    "cpu": {
        "format": "CPU {usage}%",
        "tooltip": false
    },
    "memory": {
        "format": "Mem {used}G/{total}G",
    },
    "temperature": {
        // "thermal-zone": 2,
        // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
        "critical-threshold": 80,
        // "format-critical": "{temperatureC}°C {icon}",
        "format": "{temperatureC}°C {icon}",
        "format-icons": ["", "", ""]
    },
    "backlight": {
        // "device": "acpi_video1",
        "format": "{percent}% {icon}",
        "format-icons": ["", "", "", "", "", "", "", "", ""]
    },
    "network": {
        // "interface": "wlp2*", // (Optional) To force the use of this interface
        "format-wifi": "{essid} ({signalStrength})%",
        "format-ethernet": "{ipaddr}/{cidr}",
        "format-disconnected": "Disconnected",
        "format-alt": "{ifname}: {ipaddr}/{cidr}"
    },
    "pulseaudio": {
        // "scroll-step": 1, // %, can be a float
        "format": "Vol: {volume}%",
        "on-click": "pavucontrol"
    },
    "custom/divider": {
         "format": "|"
         },
     "custom/invisdivider": {
         "format": " "
         },
"battery": {
        "bat": "BAT1",
        "interval": 60,
        "format": "BATT {capacity}%",
    },
   
    }
