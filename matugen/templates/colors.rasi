

* {
    background:     #{{ colors.background.default.hex_stripped }}FF;
    background-alt: #{{ colors.surface.default.hex_stripped }}FF;
    foreground:     #{{ colors.on_background.default.hex_stripped }}FF;
    selected:       #{{ colors.primary.default.hex_stripped }}FF;
    active:         #{{ colors.secondary.default.hex_stripped }}FF;
    urgent:         #{{ colors.error.default.hex_stripped }}FF;
}
